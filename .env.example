# Copy to .env and fill in. Every variable below must be listed here with a
# dummy value and a one-line comment — CONVENTIONS.md §3.

# Required: at least GOOGLE_API_KEY_1. Startup fails loudly if it is missing.
# More keys are numbered on, read up to the first gap; a 429 moves to the next one.
GOOGLE_API_KEY_1=your-key-here
GOOGLE_API_KEY_2=your-second-key-here

# Optional. Falls back to the default in src/config.py.
LLM_MODEL=gemini-2.5-flash
