# Secrets — never commit. .env.example carries the variable names.
.env
.env.*
!.env.example
keys.txt

# Personal notes. They govern nothing — CONVENTIONS.md §8.
*.me.md

# Environment
.venv/
__pycache__/
*.py[cod]

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Generated artifacts — rebuildable, so not tracked
outputs/
chroma_db/
*.zip

# Raw inputs. Samples are committed; add them back explicitly.
data/raw/
# Parsed from crawled pages: third-party content, never published.
data/processed/
data/chunks/
data/enriched/
# Built from data/enriched/ by python -m src.index; variants from --out (#10).
data/index/
data/index-*/
# Threshold variants: chunks, enriched chunks and index per threshold (#12).
data/t*/
# Generated answers of eval runs: they quote the corpus (#15).
data/eval-answers/

# OS and editor
.DS_Store
Thumbs.db
